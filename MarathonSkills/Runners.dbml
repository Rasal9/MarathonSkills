<?xml version="1.0" encoding="utf-8"?><Database Name="Wow_Meow" Class="RunnersDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Connection Mode="AppSettings" ConnectionString="Data Source=.;Initial Catalog=Wow_Meow;Integrated Security=True" SettingsObjectName="MarathonSkills.Properties.Settings" SettingsPropertyName="Wow_MeowConnectionString" Provider="System.Data.SqlClient" />
