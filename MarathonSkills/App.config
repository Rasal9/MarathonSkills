<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <!-- Строка подключения к БД. Замените «.» на имя вашего сервера,
             например: Data Source=.\SQLEXPRESS  или  Data Source=DESKTOP-XXXX\SQLEXPRESS
             Initial Catalog — имя вашей базы (в script.sql она называется Wow_Meow). -->
        <add name="MarathonSkills.Properties.Settings.Wow_MeowConnectionString"
            connectionString="Data Source=.;Initial Catalog=Wow_Meow;Integrated Security=True"
            providerName="System.Data.SqlClient" />
    </connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
